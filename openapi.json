{
  "openapi": "3.1.0",
  "info": {
    "title": "Brillianda API",
    "version": "0.1.0",
    "description": "Multi-tenant school registry API. The school is resolved from the request host; call it through the frontend's /api rewrite. Errors are RFC 9457 problem details (application/problem+json); see docs/api-conventions.md."
  },
  "components": {
    "schemas": {
      "PublicSchool": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "subdomain": {
            "type": "string"
          },
          "brandColor": {
            "type": [
              "string",
              "null"
            ]
          },
          "logoUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "id",
          "name",
          "subdomain",
          "brandColor",
          "logoUrl"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://brillianda.com/problems/unauthenticated"
          },
          "title": {
            "type": "string",
            "example": "Sign in required"
          },
          "status": {
            "type": "integer",
            "example": 401
          },
          "detail": {
            "type": "string",
            "example": "Please sign in."
          },
          "instance": {
            "type": "string",
            "example": "/v1/me"
          },
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "validation_failed",
              "unauthenticated",
              "forbidden",
              "csrf_rejected",
              "not_found",
              "school_not_found",
              "school_unavailable",
              "method_not_allowed",
              "conflict",
              "payload_too_large",
              "unsupported_media_type",
              "rate_limited",
              "internal",
              "service_unavailable"
            ],
            "description": "Stable machine-readable code. Switch on this."
          },
          "requestId": {
            "type": "string",
            "description": "Quote this when reporting a problem."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string"
                },
                "parameter": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "detail",
                "code"
              ]
            },
            "description": "validation_failed only: one entry per field."
          },
          "retryAfterSec": {
            "type": "integer",
            "description": "rate_limited only."
          },
          "allow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "method_not_allowed only."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "code",
          "requestId"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "fullName": {
                "type": "string"
              },
              "emailVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "email",
              "fullName",
              "emailVerified"
            ]
          },
          "membership": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "admin"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "school": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "subdomain": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "subdomain"
            ]
          }
        },
        "required": [
          "user",
          "membership",
          "school"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness: the process is up",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness: the database answers",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/school": {
      "get": {
        "tags": [
          "school"
        ],
        "summary": "Public branding for the school at this address",
        "responses": {
          "200": {
            "description": "The school",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSchool"
                }
              }
            }
          },
          "404": {
            "description": "No active school here",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user and their role in this school",
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to this school",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No active school here",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out of this school on this device",
        "description": "Always clears the cookie and returns 204, whether or not the session was still valid.",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "404": {
            "description": "No active school here",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
