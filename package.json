{
  "name": "brillianda",
  "private": true,
  "description": "Brillianda backend: multi-tenant school registry API",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@brillianda/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "db:bootstrap": "pnpm --filter @brillianda/db bootstrap",
    "db:generate": "pnpm --filter @brillianda/db generate",
    "db:migrate": "pnpm --filter @brillianda/db migrate",
    "db:seed": "pnpm --filter @brillianda/api seed",
    "db:reset": "pnpm --filter @brillianda/db reset && pnpm db:seed",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
