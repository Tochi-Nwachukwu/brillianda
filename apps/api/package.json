{
  "name": "@brillianda/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "openapi": "tsx scripts/openapi.ts",
    "bench": "tsx --env-file-if-exists=../../.env scripts/bench.ts",
    "seed:test-school": "tsx scripts/seed-test-school.ts",
    "seed:test-teachers": "tsx scripts/seed-test-teachers.ts",
    "seed:test-parent": "tsx scripts/seed-test-parent.ts",
    "team:add": "tsx scripts/team-add.ts"
  },
  "dependencies": {
    "@brillianda/auth": "workspace:*",
    "@brillianda/core": "workspace:*",
    "@brillianda/db": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.1.5",
    "@node-rs/argon2": "^2.0.2",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "@vercel/functions": "^3.9.11",
    "hono": "^4.10.6",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "vitest": "^4.0.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
