# ── Database ────────────────────────────────────────────────────────────────
# Superuser (or a role with CREATEROLE + CREATEDB). Used ONLY by `pnpm db:bootstrap`
# to create the two roles and the database. Never give this to the API.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres

# Owner role: owns every table, runs migrations. Never given to the running API.
DATABASE_OWNER_URL=postgres://brillianda_owner:owner_dev_password@localhost:5433/brillianda

# App role: what the API connects as. Not a superuser, no BYPASSRLS, owns nothing.
# In production point this at the pooled (transaction-mode) endpoint.
DATABASE_URL=postgres://brillianda_app:app_dev_password@localhost:5433/brillianda

# Passwords the bootstrap script sets on the roles (local/CI only).
DB_OWNER_PASSWORD=owner_dev_password
DB_APP_PASSWORD=app_dev_password
# Read-only role for pg_dump. Leave empty and the role cannot log in.
DB_BACKUP_PASSWORD=backup_dev_password
DB_NAME=brillianda

# Remote migrations take a Neon snapshot branch first (docs/safety.md). Not needed locally.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Tests create and drop their own database through this URL.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Apex domain. Schools live at <subdomain>.ROOT_DOMAIN.
# Locally: localhost, so surebloom.localhost:3000 works in Chrome without hosts-file edits.
ROOT_DOMAIN=localhost

# Public scheme the browser uses (https in production).
PUBLIC_PROTOCOL=http

# 32+ random bytes, base64. HMAC key for every stored token hash (sessions, codes, links).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-32-random-bytes-base64

# Shared secret between the frontend's /api rewrite and this API. Only requests carrying it
# may set x-forwarded-host; everything else is resolved from the Host header.
PROXY_SHARED_SECRET=replace-me-with-another-random-secret

# Preview deployments have no school subdomains; when true, ?school=<subdomain> is accepted.
ALLOW_SCHOOL_QUERY_PARAM=false

# Port browsers use for the FRONTEND (links in emails). Locally 3000; unset in production.
PUBLIC_PORT=3000

# Email. "console" prints every email (codes, links) in the pnpm dev terminal. A real provider
# adapter is required before production (the API refuses to start in production with console).
MAIL_PROVIDER=console
MAIL_FROM="Brillianda <no-reply@brillianda.com>"

# Cloudflare Turnstile (signup bot check). Unset locally = every check passes. Required in production.
TURNSTILE_SECRET_KEY=

# Upstash (optional locally: an in-memory limiter is used when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
