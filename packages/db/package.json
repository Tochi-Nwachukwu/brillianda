{
  "name": "@brillianda/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "bootstrap": "tsx --env-file-if-exists=../../.env scripts/bootstrap.ts",
    "migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "reset": "tsx --env-file-if-exists=../../.env scripts/reset.ts",
    "check-migrations": "tsx scripts/check-migrations.ts",
    "verify-restore": "tsx --env-file-if-exists=../../.env scripts/verify-restore.ts"
  },
  "dependencies": {
    "@brillianda/core": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.3",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.6",
    "vitest": "^4.0.10"
  }
}
